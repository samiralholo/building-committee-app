# Copy to `.env` for local development. On Vercel, set these as Environment Variables.
# Supabase → Project Settings → API (or "Connect" button)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Optional: pilot with one building — the home page "/" opens this building directly.
DEFAULT_BUILDING_SLUG=al-yasmin-14

# Optional: keep "false" during the pilot (no public admin signup in the UI).
ENABLE_PUBLIC_SIGNUP=false
