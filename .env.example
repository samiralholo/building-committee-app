# Copy to `.env` for local development. On Vercel, set these as Environment Variables.
# Supabase → Project Settings → API Keys (or the "Connect" button)

# --- Browser (bundled into the Angular app) — PUBLIC values only -------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# anon / publishable key (sb_publishable_…). The build REFUSES secret/service_role keys here.
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-OR-PUBLISHABLE-KEY

# Optional: keep "false" (no public admin signup in the UI; the Super Admin creates admins).
ENABLE_PUBLIC_SIGNUP=false

# --- Server only (Vercel serverless functions in /api) — NEVER in the browser --
# Supabase secret key (sb_secret_…) or legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SECRET-KEY
